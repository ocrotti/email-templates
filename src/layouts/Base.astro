---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import type { Lang, RouteKey } from '../lib/routes';
import { routes } from '../lib/routes';
import { t } from '../lib/i18n';
import { SITE, absoluteUrl, organizationSchema } from '../lib/seo';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Lang;
  /** Chiave della route per hreflang + language switcher. */
  routeKey?: RouteKey;
  /** Override esplicito per pagine dinamiche non in mappa. */
  alternates?: { it: string; en: string };
  title: string;
  description: string;
  /** Percorso relativo dell'immagine OG (1200×630). */
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Blocchi JSON-LD aggiuntivi (Service, FAQPage, Article, BreadcrumbList, Person…). */
  schema?: object[];
}

const {
  lang,
  routeKey,
  alternates,
  title,
  description,
  ogImage = `/og/default-${lang}.png`,
  ogType = 'website',
  noindex = false,
  schema = [],
} = Astro.props;

const strings = t(lang);
const alt = alternates ?? (routeKey ? routes[routeKey] : undefined);
const canonical = absoluteUrl(Astro.url.pathname);
const ogLocale = lang === 'it' ? 'it_IT' : 'en_US';
const ogLocaleAlt = lang === 'it' ? 'en_US' : 'it_IT';
const jsonLd = [organizationSchema(lang), ...schema];
const switchHref = alt ? alt[lang === 'it' ? 'en' : 'it'] : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {/* Un canonical su una pagina noindex (la 404) sarebbe un segnale contraddittorio */}
    {!noindex && <link rel="canonical" href={canonical} />}
    {
      alt && (
        <>
          <link rel="alternate" hreflang="it" href={absoluteUrl(alt.it)} />
          <link rel="alternate" hreflang="en" href={absoluteUrl(alt.en)} />
          <link rel="alternate" hreflang="x-default" href={absoluteUrl(alt.it)} />
        </>
      )
    }
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteUrl(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteUrl(ogImage)} />
    <meta name="theme-color" content="#0e0d0b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="preload"
      href="/fonts/parkinsans-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-standard-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {jsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">{strings.skipLink}</a>
    <Nav lang={lang} switchHref={switchHref} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
