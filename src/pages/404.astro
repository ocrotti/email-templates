---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { t } from '../lib/i18n';

const it = t('it');
const en = t('en');
---

<Base
  lang="it"
  title="404 — Pagina non trovata | enable.advisory"
  description="La pagina che cerchi non esiste o è stata spostata."
  noindex
>
  <section class="wrap flex min-h-svh flex-col justify-center py-32">
    <p class="sec-num text-accent" aria-hidden="true">404</p>
    <h1 class="font-display text-h2 mt-6 font-medium">{it.notFound.title}</h1>
    <p class="mt-4 max-w-md text-lead text-mist">{it.notFound.text}</p>
    <div class="mt-10 flex flex-wrap gap-4">
      <Button href="/it/">{it.notFound.back}</Button>
    </div>
    <div class="hairline mt-16 max-w-md pt-8" lang="en">
      <h2 class="font-display text-[1.25rem] font-medium">{en.notFound.title}</h2>
      <p class="mt-2 text-[0.9375rem] text-mist">{en.notFound.text}</p>
      <p class="mt-4">
        <a href="/en/" class="link-underline font-medium">{en.notFound.back}</a>
      </p>
    </div>
  </section>
</Base>
