---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Pill from '../../components/Pill.astro';
import Button from '../../components/Button.astro';
import ArrowLink from '../../components/ArrowLink.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Steps from '../../components/Steps.astro';
import ContactForm from '../../components/ContactForm.astro';
import { path } from '../../lib/routes';

const lang = 'en' as const;

const nextSteps = [
  {
    title: 'We reply within one business day',
    text: 'A reply written by a person, with real questions about your situation. Not a template, not “thanks, we’ll be in touch”.',
  },
  {
    title: 'Thirty minutes with a senior',
    text: 'A call with the specialist for your topic, to work out whether we can be useful. No company deck, no salesperson on cc.',
  },
  {
    title: 'We tell you what makes sense — or that it doesn’t',
    text: 'If it makes sense, we propose the right entry product, with price and duration stated up front. If it doesn’t, we say so — and we tell you who to call instead.',
  },
];

const products = [
  {
    title: 'Digital & Compliance Audit',
    note: 'Digital maturity and regulatory gaps, in two weeks.',
  },
  {
    title: 'AI Readiness Assessment',
    note: 'Where AI actually pays back, and where it is just fashion.',
  },
  {
    title: 'CRM/Martech Sprint',
    note: 'Your CRM stops being an address book.',
  },
  {
    title: 'Accessibility (EAA) Sprint',
    note: 'A compliant site or store, with a publishable statement.',
  },
] as const;

const verticals = [
  {
    key: 'serviceCompliance',
    title: 'Compliance & digital governance',
    note: 'GDPR, NIS2, EAA, AI Act.',
  },
  { key: 'serviceData', title: 'Data & AI', note: 'AI-native for SMEs.' },
  { key: 'serviceCrm', title: 'CRM & martech', note: 'Turn your customer base into value.' },
  {
    key: 'serviceWeb',
    title: 'Web, tech & e-commerce',
    note: 'A digital presence that converts and complies.',
  },
] as const;
---

<Base
  lang={lang}
  routeKey="contact"
  title="Contact: book your audit | enable.advisory"
  description="Talk to a senior at enable.advisory: we reply within one business day, always a person. Book your audit, a 30-minute call, or just tell us your context."
  ogImage="/og/contact-en.png"
>
  <Breadcrumbs lang={lang} items={[{ name: 'Contact', path: path('contact', lang) }]} />

  <!-- ============================== HERO ============================== -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0"
      aria-hidden="true"
      style="background: radial-gradient(50rem 34rem at 90% -20%, rgb(43 92 255 / 0.11), transparent 60%);"
    >
    </div>
    <div class="wrap relative pt-12 pb-20 md:pt-16 md:pb-28">
      <p class="label-caps text-mist" data-reveal>Contact</p>
      <h1 class="font-display text-display mt-6 max-w-5xl font-medium" data-reveal>
        Talk to a senior
      </h1>
      <p class="mt-8 max-w-xl text-lead text-mist" data-reveal>
        Write to us here and we reply within one business day. A person replies — one of the
        seniors, not a salesperson and not an autoresponder. Even when the answer is “you don’t
        need us”.
      </p>
      <ul class="mt-12 flex flex-wrap gap-3" data-reveal-group>
        <li data-reveal><Pill>Reply within one business day</Pill></li>
        <li data-reveal><Pill>Always a senior</Pill></li>
        <li data-reveal><Pill>Never an autoresponder</Pill></li>
        <li data-reveal><Pill>A no, when it is a no</Pill></li>
      </ul>
    </div>
  </section>

  <!-- ====================== FORM + OTHER CHANNELS ====================== -->
  <section class="hairline">
    <div class="wrap grid grid-cols-12 gap-x-6 gap-y-16 py-24 md:py-36">
      <!-- Left column: the form -->
      <div class="col-span-12 lg:col-span-7">
        <p class="label-caps text-mist" data-reveal>Write to us</p>
        <h2 class="font-display text-h2 mt-4 font-medium" data-reveal>Tell us where you are.</h2>
        <p class="mt-6 max-w-xl text-[0.9375rem] text-mist" data-reveal>
          The more context you give us, the more useful the first reply: company size, sector,
          what isn’t working, the regulatory deadlines breathing down your neck. If you already
          know what you need, say so; if you don’t, that’s fine too.
        </p>
        <div class="mt-12" data-reveal>
          <ContactForm lang={lang} />
        </div>
      </div>

      <!-- Right column: direct channels -->
      <div class="col-span-12 lg:col-span-4 lg:col-start-9">
        <div class="rounded-xs border border-white/15 bg-ink-raise p-8 md:p-10">
          <p class="label-caps text-mist" data-reveal>Other channels</p>
          <h2 class="font-display mt-4 text-[1.75rem] leading-tight font-medium" data-reveal>
            Rather talk it through?
          </h2>
          <p class="mt-4 text-[0.9375rem] text-mist" data-reveal>
            The form isn’t the only door. Three ways to reach a person directly.
          </p>

          <div class="hairline mt-8 pt-8" data-reveal>
            <h3 class="font-display text-[1.125rem] font-medium">A 30-minute call</h3>
            <p class="mt-2 text-[0.9375rem] text-mist">
              Pick your own slot on the calendar. Half an hour with the senior for your topic: you
              leave with an opinion, not a quote.
            </p>
            {/* Not a link until the URL exists: a placeholder href would lead
                to a 404. At launch restore
                <Button href="…" variant="ghost">Open the calendar</Button>. */}
            <div class="mt-5">
              <span class="btn btn-ghost cursor-not-allowed opacity-60" aria-disabled="true">
                Open the calendar
              </span>
            </div>
            <p class="mt-3 text-[0.8125rem] text-mist">
              [PLACEHOLDER: URL calendario — Cal.com/Calendly]
            </p>
          </div>

          <div class="hairline mt-8 pt-8" data-reveal>
            <h3 class="font-display text-[1.125rem] font-medium">WhatsApp</h3>
            <p class="mt-2 text-[0.9375rem] text-mist">
              For the short questions, when opening your email client is already too much.
            </p>
            {/* Same: at launch restore <a href="https://wa.me/…">. */}
            <p class="mt-4">
              <span class="text-paper opacity-60">Message us on WhatsApp</span>
            </p>
            <p class="mt-3 text-[0.8125rem] text-mist">[PLACEHOLDER: link wa.me]</p>
          </div>

          <div class="hairline mt-8 pt-8" data-reveal>
            <h3 class="font-display text-[1.125rem] font-medium">Direct email</h3>
            <p class="mt-2 text-[0.9375rem] text-mist">
              If you prefer your own inbox and your own attachments.
            </p>
            <p class="mt-4 text-[0.9375rem] text-paper">[PLACEHOLDER: email]</p>
          </div>

          <p class="hairline mt-8 pt-8 text-[0.8125rem] text-mist" data-reveal>
            The final calendar link, number and address are being published: the three contacts
            above are placeholders. In the meantime the form reaches a person, not a queue.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================= WHAT HAPPENS NEXT ======================== -->
  <section class="section-light">
    <div class="py-24 md:py-36">
      <Steps
        num="01"
        label="What happens next"
        title="Three steps, no surprises."
        intro="What happens after you hit send, without the polite formulas."
        steps={nextSteps}
        light
      />
    </div>
  </section>

  <!-- ========================= WHERE TO START =========================== -->
  <section class="hairline">
    <div class="wrap py-24 md:py-36">
      <SectionHeading num="02" label="Getting oriented" title="Not sure where to start?">
        <p class="mt-6 max-w-2xl text-lead text-mist" data-reveal>
          That’s fine: most conversations begin exactly there. If you want a clearer picture before
          you write, these are the two places to look.
        </p>
      </SectionHeading>

      <div class="mt-16 grid grid-cols-12 gap-x-6 gap-y-14">
        <div class="col-span-12 md:col-span-5">
          <p class="label-caps text-mist" data-reveal>The four entry products</p>
          <ul class="mt-8 space-y-6" data-reveal-group>
            {
              products.map((p) => (
                <li data-reveal>
                  <ArrowLink href={path('products', lang)} class="text-paper">
                    {p.title}
                  </ArrowLink>
                  <p class="mt-1.5 text-[0.9375rem] text-mist">{p.note}</p>
                </li>
              ))
            }
          </ul>
          <p class="mt-8 text-[0.875rem] text-mist" data-reveal>
            Fixed price, stated duration, and a deliverable that stays yours even if we stop there.
          </p>
        </div>

        <div class="col-span-12 md:col-span-6 md:col-start-7">
          <p class="label-caps text-mist" data-reveal>The four verticals</p>
          <ul class="mt-8 space-y-6" data-reveal-group>
            {
              verticals.map((v) => (
                <li data-reveal>
                  <ArrowLink href={path(v.key, lang)} class="text-paper">
                    {v.title}
                  </ArrowLink>
                  <p class="mt-1.5 text-[0.9375rem] text-mist">{v.note}</p>
                </li>
              ))
            }
          </ul>
          <p class="mt-8 text-[0.875rem] text-mist" data-reveal>
            One vertical alone is rarely enough: <a
              href={path('services', lang)}
              class="link-plain text-paper">the four work as one system</a
            >, orchestrated by a single accountable partner.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
