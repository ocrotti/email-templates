---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Pill from '../../components/Pill.astro';
import Button from '../../components/Button.astro';
import ArrowLink from '../../components/ArrowLink.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Steps from '../../components/Steps.astro';
import CtaSection from '../../components/CtaSection.astro';
import { path } from '../../lib/routes';

const lang = 'it' as const;

const method = [
  {
    title: 'Contesto',
    text: 'Da dove si partiva: settore, dimensione, il problema vero e la scadenza che lo rendeva urgente. Un numero senza il punto di partenza non dimostra niente.',
  },
  {
    title: 'Intervento',
    text: 'Cosa abbiamo fatto e in quanto tempo: perimetro dell’ingaggio, senior coinvolti, cosa è rimasto in azienda il giorno in cui abbiamo chiuso.',
  },
  {
    title: 'Risultato',
    text: 'I numeri misurati, con baseline, periodo di riferimento e metodo di calcolo dichiarati. Uno o due, quelli che contano — non una griglia di percentuali.',
  },
];
---

<Base
  lang={lang}
  routeKey="caseStudies"
  title="Casi studio | enable.advisory"
  description="Casi studio di digitalizzazione per PMI: contesto, intervento e risultati con numeri verificabili, autorizzati dal cliente. I primi casi in pubblicazione."
  ogImage="/og/caseStudies-it.png"
>
  <Breadcrumbs lang={lang} items={[{ name: 'Casi studio', path: path('caseStudies', lang) }]} />

  <!-- ============================== HERO ============================== -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0"
      aria-hidden="true"
      style="background: radial-gradient(50rem 34rem at 90% -20%, rgb(43 92 255 / 0.11), transparent 60%);"
    >
    </div>
    <div class="wrap relative pt-12 pb-20 md:pt-16 md:pb-28">
      <p class="label-caps text-mist" data-reveal>Casi studio</p>
      <h1 class="font-display text-display mt-6 max-w-6xl font-medium" data-reveal>
        Casi studio di digitalizzazione: contesto, intervento, risultato.
      </h1>
      <p class="mt-8 max-w-xl text-lead text-mist" data-reveal>
        I primi case study sono in pubblicazione con i clienti che li hanno autorizzati. Fino ad
        allora questa pagina resta senza casi: una casella vuota è più utile di una metrica
        inventata.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4" data-reveal>
        <Button href={path('contact', lang)}>Parla con un senior</Button>
        <Button href={path('products', lang)} variant="ghost">
          Inizia con un passo a prezzo fisso
        </Button>
      </div>
      <ul class="mt-12 flex flex-wrap gap-3" data-reveal-group>
        <li data-reveal><Pill>Numeri verificabili</Pill></li>
        <li data-reveal><Pill>Autorizzati dal cliente</Pill></li>
        <li data-reveal><Pill>Nessun logo senza permesso</Pill></li>
      </ul>
    </div>
  </section>

  <!-- ======================= 01 COME DOCUMENTIAMO ======================= -->
  <section class="section-light">
    <div class="py-24 md:py-36">
      <Steps
        num="01"
        label="Come documentiamo un caso"
        title="Tre blocchi, sempre gli stessi, sempre in quest’ordine."
        intro="Contesto, intervento, risultato. Se manca uno dei tre — di solito il primo o il terzo — il caso non esce. È il nostro standard anti-fuffa, ed è la stessa accountability che mettiamo nei progetti."
        steps={method}
        light
      />
      <div class="wrap mt-16" data-reveal>
        <ArrowLink href={path('howWeWork', lang)} class="text-accent-deep">
          Come lavoriamo, in dettaglio
        </ArrowLink>
      </div>
    </div>
  </section>

  <!-- ==================== 02 PERCHÉ QUESTA PAGINA È VUOTA ==================== -->
  <section class="hairline">
    <div class="wrap py-24 md:py-36">
      <SectionHeading
        num="02"
        label="Lo standard"
        title="Perché non trovi loghi, percentuali roboanti e testimonianze."
      >
        <p class="mt-6 max-w-2xl text-lead text-mist" data-reveal>
          Essere accountable sul risultato significa anche rispondere dei numeri che pubblichiamo,
          non solo di quelli che promettiamo. Tre regole, valide anche quando ci costano una pagina
          più povera.
        </p>
      </SectionHeading>
      <div class="mt-16 grid grid-cols-12 gap-x-6 gap-y-12" data-reveal-group>
        <div class="col-span-12 md:col-span-4" data-reveal>
          <p class="font-display text-[1.375rem] font-semibold text-accent-soft" aria-hidden="true">
            1
          </p>
          <h3 class="font-display mt-3 text-[1.25rem] font-medium">
            Nessun logo senza autorizzazione scritta
          </h3>
          <p class="mt-3 text-[0.9375rem] text-mist">
            Una griglia di loghi è la cosa più facile da mettere in pagina e la più difficile da
            difendere. Molte aziende, per policy interna o per riservatezza sul progetto, non
            vogliono comparire: rispettarlo fa parte del lavoro. Quando l’autorizzazione arriva, il
            nome compare. Prima, no.
          </p>
        </div>
        <div class="col-span-12 md:col-span-4" data-reveal>
          <p class="font-display text-[1.375rem] font-semibold text-accent-soft" aria-hidden="true">
            2
          </p>
          <h3 class="font-display mt-3 text-[1.25rem] font-medium">
            Nessuna metrica che non possiamo mostrare
          </h3>
          <p class="mt-3 text-[0.9375rem] text-mist">
            “+300% di lead” senza baseline, senza periodo e senza metodo di calcolo è un numero di
            marketing, non un risultato. Pubblichiamo solo dati che il cliente ha visto, riletto e
            approvato — e scriviamo da dove partivano. Se un numero non regge una domanda in più,
            non lo pubblichiamo.
          </p>
        </div>
        <div class="col-span-12 md:col-span-4" data-reveal>
          <p class="font-display text-[1.375rem] font-semibold text-accent-soft" aria-hidden="true">
            3
          </p>
          <h3 class="font-display mt-3 text-[1.25rem] font-medium">
            Se il cliente resta anonimo, lo diciamo
          </h3>
          <p class="mt-3 text-[0.9375rem] text-mist">
            Alcuni casi usciranno senza nome: settore e dimensione al posto del marchio. In quel
            caso lo dichiariamo apertamente, invece di far intuire chi sia. I numeri restano gli
            stessi e l’autorizzazione pure: cambia solo cosa possiamo scrivere in copertina.
          </p>
        </div>
      </div>

      <div class="mt-16 rounded-xs border border-white/15 bg-ink-raise p-8 md:p-10" data-reveal>
        <p class="label-caps text-mist">Il criterio, in una riga</p>
        <p class="mt-4 max-w-3xl text-[0.9375rem] text-mist">
          Un caso studio serve a farti valutare se sappiamo fare il tuo lavoro, non a farci belli.
          Per questo preferiamo pubblicarne pochi, verificabili, con il permesso di chi li ha
          vissuti — e dire chiaramente quando ancora non ne abbiamo.
        </p>
      </div>
    </div>
  </section>

  <!-- ====================== 03 LA STRUTTURA, INTANTO ====================== -->
  <section class="hairline">
    <div class="wrap py-24 md:py-36">
      <SectionHeading
        num="03"
        label="La struttura"
        title="Come sarà fatta ogni scheda, quando i primi casi usciranno."
      >
        <p class="mt-6 max-w-2xl text-lead text-mist" data-reveal>
          Le due schede qui sotto mostrano solo la struttura: non sono casi reali, non contengono
          dati e non sono cliccabili. Restano qui finché non c’è qualcosa di vero da metterci
          dentro.
        </p>
      </SectionHeading>

      <div class="mt-14 grid grid-cols-1 gap-5 md:grid-cols-2" data-reveal-group>
        <div
          class="rounded-xs border border-dashed border-white/20 bg-ink-raise p-8 md:p-9"
          data-reveal
        >
          <p class="label-caps text-accent-soft">[PLACEHOLDER: caso studio in pubblicazione]</p>
          <h3 class="font-display mt-5 text-[1.375rem] leading-tight font-medium">
            [PLACEHOLDER: titolo del caso — il risultato, non il nome del progetto]
          </h3>
          <p class="mt-2 text-[0.875rem] text-mist">
            Verticale: compliance &amp; governance digitale · [PLACEHOLDER: settore e dimensione]
          </p>
          <dl class="mt-8 space-y-6">
            <div class="border-t-2 border-accent pt-4">
              <dt class="font-display text-[1.0625rem] font-medium">Contesto</dt>
              <dd class="mt-2 text-[0.9375rem] text-mist">
                [PLACEHOLDER: punto di partenza, problema e scadenza che lo rendeva urgente]
              </dd>
            </div>
            <div class="border-t-2 border-accent pt-4">
              <dt class="font-display text-[1.0625rem] font-medium">Intervento</dt>
              <dd class="mt-2 text-[0.9375rem] text-mist">
                [PLACEHOLDER: perimetro, durata, senior coinvolti, cosa resta in azienda]
              </dd>
            </div>
            <div class="border-t-2 border-accent pt-4">
              <dt class="font-display text-[1.0625rem] font-medium">Risultato</dt>
              <dd class="mt-2 text-[0.9375rem] text-mist">
                [PLACEHOLDER: uno o due numeri misurati, con baseline e periodo]
              </dd>
            </div>
          </dl>
        </div>

        <div
          class="rounded-xs border border-dashed border-white/20 bg-ink-raise p-8 md:p-9"
          data-reveal
        >
          <p class="label-caps text-accent-soft">[PLACEHOLDER: caso studio in pubblicazione]</p>
          <h3 class="font-display mt-5 text-[1.375rem] leading-tight font-medium">
            [PLACEHOLDER: titolo del caso — il risultato, non il nome del progetto]
          </h3>
          <p class="mt-2 text-[0.875rem] text-mist">
            Verticale: dati &amp; AI · [PLACEHOLDER: settore e dimensione]
          </p>
          <dl class="mt-8 space-y-6">
            <div class="border-t-2 border-accent pt-4">
              <dt class="font-display text-[1.0625rem] font-medium">Contesto</dt>
              <dd class="mt-2 text-[0.9375rem] text-mist">
                [PLACEHOLDER: punto di partenza, problema e scadenza che lo rendeva urgente]
              </dd>
            </div>
            <div class="border-t-2 border-accent pt-4">
              <dt class="font-display text-[1.0625rem] font-medium">Intervento</dt>
              <dd class="mt-2 text-[0.9375rem] text-mist">
                [PLACEHOLDER: perimetro, durata, senior coinvolti, cosa resta in azienda]
              </dd>
            </div>
            <div class="border-t-2 border-accent pt-4">
              <dt class="font-display text-[1.0625rem] font-medium">Risultato</dt>
              <dd class="mt-2 text-[0.9375rem] text-mist">
                [PLACEHOLDER: uno o due numeri misurati, con baseline e periodo]
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="mt-14 flex flex-wrap gap-x-10 gap-y-4" data-reveal>
        <ArrowLink href={path('services', lang)} class="text-paper">
          I quattro verticali
        </ArrowLink>
        <ArrowLink href={path('products', lang)} class="text-paper">
          I prodotti a prezzo fisso
        </ArrowLink>
        <ArrowLink href={path('resources', lang)} class="text-paper">
          Guide e risorse
        </ArrowLink>
      </div>
    </div>
  </section>

  <!-- ========================= 04 I PRIMI CLIENTI ========================= -->
  <section class="section-light">
    <div class="wrap grid grid-cols-12 gap-x-6 py-24 md:py-36">
      <div class="col-span-12 lg:col-span-6">
        <span class="sec-num block text-accent-deep" aria-hidden="true" data-reveal>04</span>
        <p class="label-caps mt-4 text-umber" data-reveal>I primi clienti</p>
        <h2 class="font-display text-h2 mt-4 font-medium" data-reveal>
          Vuoi essere tra i primi casi che pubblichiamo?
        </h2>
        <p class="mt-6 max-w-md text-lead text-umber" data-reveal>
          I clienti early hanno condizioni dedicate. In cambio ci autorizzi a raccontare il lavoro
          quando i risultati ci sono — con i numeri veri, riletti e approvati da te prima della
          pubblicazione.
        </p>
      </div>
      <div class="col-span-12 mt-12 lg:col-span-5 lg:col-start-8 lg:mt-0" data-reveal>
        <div class="rounded-xs border border-ink/15 bg-white/40 p-8">
          <p class="label-caps text-umber">Condizioni early</p>
          <p class="mt-4 text-[0.9375rem] text-umber">
            [PLACEHOLDER: condizioni riservate ai primi clienti — sconto, perimetro esteso o
            priorità di agenda, da definire]
          </p>
          <ul class="mt-6 space-y-2 text-[0.9375rem] text-umber">
            <li>Nessun obbligo di comparire con il nome: puoi restare anonimo.</li>
            <li>Il testo del caso lo approvi tu, riga per riga, prima che vada online.</li>
            <li>Se i risultati non ci sono, non pubblichiamo nulla.</li>
          </ul>
          <p class="mt-8" data-reveal>
            <ArrowLink href={path('contact', lang)} class="text-accent-deep">
              Scrivici: risposta entro 24 ore lavorative
            </ArrowLink>
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaSection lang={lang} />
</Base>
