---
/** Card prodotto d'ingresso a prezzo fisso. */
interface Props {
  title: string;
  price: string;
  duration: string;
  description: string;
  deliverables: string[];
  deliverablesLabel: string;
  href: string;
  ctaLabel: string;
  light?: boolean;
}
const {
  title,
  price,
  duration,
  description,
  deliverables,
  deliverablesLabel,
  href,
  ctaLabel,
  light = false,
} = Astro.props;
---

<article
  class:list={[
    'flex flex-col justify-between rounded-xs border p-7 md:p-9',
    light ? 'border-ink/15 bg-white/40' : 'border-white/15 bg-ink-raise',
  ]}
>
  <div>
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h3 class="font-display text-[1.375rem] leading-tight font-medium md:text-[1.5rem]">
        {title}
      </h3>
      <p
        class:list={[
          'font-display text-[1.125rem] font-semibold whitespace-nowrap',
          light ? 'text-accent-deep' : 'text-accent-soft',
        ]}
      >
        {price}
      </p>
    </div>
    <p class:list={['mt-1 text-[0.8125rem]', light ? 'text-umber' : 'text-mist']}>
      {duration}
    </p>
    <p class="mt-5 text-[0.9375rem]">{description}</p>
    <h4 class:list={['label-caps mt-6', light ? 'text-umber' : 'text-mist']}>
      {deliverablesLabel}
    </h4>
    <ul class="mt-3 space-y-2 text-[0.9375rem]">
      {
        deliverables.map((d) => (
          <li class="flex gap-3">
            <span
              class:list={[
                'mt-2.5 h-1 w-4 shrink-0',
                light ? 'bg-accent-deep' : 'bg-accent',
              ]}
              aria-hidden="true"
            />
            <span>{d}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="mt-8">
    <a href={href} class="group inline-flex items-center gap-1.5 font-medium">
      <span class="link-underline">{ctaLabel}</span>
      <svg
        width="13"
        height="13"
        viewBox="0 0 16 16"
        fill="none"
        aria-hidden="true"
        class="transition-transform duration-450 group-hover:translate-x-0.5"
      >
        <path
          d="M1 8h13M9 3l5 5-5 5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </a>
  </div>
</article>
