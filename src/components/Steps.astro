---
/**
 * Sezione step numerati con colonna sinistra sticky (CSS, zero CLS)
 * e progress line verticale che si disegna con lo scroll (scrub).
 */
interface Props {
  num: string;
  label: string;
  title: string;
  intro?: string;
  steps: { title: string; text: string }[];
  /** id del titolo, per il collegamento aria-labelledby della sezione. */
  titleId?: string;
  light?: boolean;
}
const { num, label, title, intro, steps, titleId, light = false } = Astro.props;
---

<div class="wrap grid grid-cols-12 gap-x-6">
  <div class="col-span-12 lg:col-span-5">
    <div class="lg:sticky lg:top-32">
      <span
        class:list={['sec-num block', light ? 'text-accent-deep' : 'text-accent']}
        aria-hidden="true"
        data-reveal>{num}</span
      >
      <p class:list={['label-caps mt-4', light ? 'text-umber' : 'text-mist']} data-reveal>
        {label}
      </p>
      <h2 id={titleId} class="font-display text-h2 mt-4 font-medium" data-reveal>{title}</h2>
      {
        intro && (
          <p
            class:list={['mt-6 max-w-md text-lead', light ? 'text-umber' : 'text-mist']}
            data-reveal
          >
            {intro}
          </p>
        )
      }
    </div>
  </div>

  <div class="col-span-12 mt-14 lg:col-span-6 lg:col-start-7 lg:mt-2">
    <div class="relative" data-steps>
      <div class="progress-track" aria-hidden="true">
        <div class="progress-fill" data-progress-line></div>
      </div>
      <ol class="list-none space-y-0 pl-10 md:pl-14">
      {
        steps.map((step, i) => (
          <li class="step-item relative py-7 first:pt-0 last:pb-0" data-step>
            <span
              class:list={[
                'step-num font-display absolute -left-7 block text-[1.0625rem] font-semibold md:-left-10',
                light ? 'text-umber' : 'text-mist',
              ]}
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="font-display text-[1.25rem] leading-snug font-medium md:text-[1.375rem]">
              {step.title}
            </h3>
            <p class:list={['mt-2 text-[0.9375rem]', light ? 'text-umber' : 'text-mist']}>
              {step.text}
            </p>
          </li>
        ))
      }
      </ol>
    </div>
  </div>
</div>
