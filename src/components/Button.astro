---
/** CTA unico del sito: bottone (primary/ghost) magnetico con freccia. */
interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  arrow?: boolean;
  class?: string;
}
const { href, variant = 'primary', arrow = true, class: className = '' } = Astro.props;
---

<a
  href={href}
  class:list={['btn', variant === 'primary' ? 'btn-primary' : 'btn-ghost', className]}
  data-magnetic
>
  <slot />
  {
    arrow && (
      <svg
        class="btn-arrow"
        width="15"
        height="15"
        viewBox="0 0 16 16"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M1 8h13M9 3l5 5-5 5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
</a>
