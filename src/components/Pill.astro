---
interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-[0.8125rem] font-medium',
    light ? 'border-ink/20 text-ink' : 'border-white/20 text-paper',
  ]}
>
  <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
  <slot />
</span>
