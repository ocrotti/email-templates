---
/** Card di un verticale/servizio: numero, titolo, claim, hover ricco. */
interface Props {
  href: string;
  num: string;
  title: string;
  claim: string;
  items?: string[];
  linkLabel: string;
  light?: boolean;
}
const { href, num, title, claim, items = [], linkLabel, light = false } = Astro.props;
---

<a
  href={href}
  class:list={[
    'card-lift group flex min-h-72 flex-col justify-between rounded-xs border p-7 no-underline md:p-9',
    light ? 'border-ink/15 text-ink' : 'border-white/15 bg-ink-raise text-paper',
  ]}
  data-tilt
>
  <div>
    <div class="flex items-start justify-between gap-4">
      <span
        class:list={[
          'font-display text-[1.75rem] font-semibold',
          light ? 'card-swap text-accent-deep' : 'card-swap text-accent-soft',
        ]}
        aria-hidden="true">{num}</span
      >
      <svg
        class="card-arrow mt-2"
        width="18"
        height="18"
        viewBox="0 0 16 16"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M3 13L13 3M5 3h8v8"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </div>
    <h3 class="font-display mt-6 text-[1.5rem] leading-tight font-medium md:text-[1.75rem]">
      {title}
    </h3>
    <p class:list={['card-swap mt-3 text-[0.9375rem]', light ? 'text-umber' : 'text-mist']}>
      {claim}
    </p>
    {
      items.length > 0 && (
        <ul
          class:list={[
            'card-swap mt-5 flex flex-wrap gap-x-4 gap-y-1.5 text-[0.8125rem]',
            light ? 'text-umber' : 'text-mist',
          ]}
        >
          {items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }
  </div>
  <span class="mt-8 inline-flex items-center gap-1.5 text-[0.9375rem] font-medium">
    <span class="link-underline">{linkLabel}</span>
  </span>
</a>
