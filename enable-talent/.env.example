# Copy to .env.local for development, or set these in your hosting provider.

# Absolute origin of the deployed site. Every canonical URL, hreflang alternate,
# sitemap entry and JSON-LD URL is built from this, so it must be set in
# production or they will all point at the default domain.
NEXT_PUBLIC_SITE_URL=https://enabletalent.com

# Where contact-form leads are delivered. Any endpoint that accepts a JSON POST:
# a Formspree or Basin form endpoint, a Zapier/Make/n8n webhook, a Slack incoming
# webhook, or your own CRM.
#
# Leave this unset and production will REFUSE leads with a 503 rather than
# accept one it cannot deliver — the form then shows the fallback email address.
LEAD_WEBHOOK_URL=

# Optional. Sent as `Authorization: Bearer <token>` with the lead payload.
LEAD_WEBHOOK_TOKEN=
